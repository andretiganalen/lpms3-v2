<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= @title || "LenO Mobile" %> · LPMS-3</title>
  <link rel="stylesheet" href="<%= lpms3_asset_path(digest: OpenProject::Lpms3::Assets.digest, asset: "uix/uix.css") %>">
  <style nonce="<%= content_security_policy_nonce %>">
    body.lm-body{margin:0;background:var(--uix-surface-page);font-family:Inter,system-ui,sans-serif;color:var(--uix-text-head)}
    .lm-phone{max-width:390px;min-height:100vh;margin:0 auto;display:flex;flex-direction:column;background:var(--uix-surface-subtle);box-sizing:border-box}
    @media (min-width:600px){.lm-phone{min-height:844px;margin:24px auto;border-radius:28px;overflow:hidden;box-shadow:0 8px 30px rgba(18,24,38,.12)}}
    .lm-header{background:var(--uix-surface);padding:20px 20px 14px;display:flex;flex-direction:column;gap:12px;border-bottom:1px solid var(--uix-border)}
    .lm-header-row{display:flex;justify-content:space-between;align-items:center;gap:8px}
    .lm-eyebrow{font-size:13px;color:var(--uix-text-secondary);font-weight:500}
    .lm-h1{margin:0;font-size:24px;font-weight:700;letter-spacing:-0.01em}
    .lm-h2{margin:0;font-size:17px;font-weight:600;line-height:1.35}
    .lm-h3{margin:0;font-size:15px;font-weight:600}
    .lm-back{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:12px;color:var(--uix-text-head);text-decoration:none;font-size:22px}
    .lm-icon-btn{position:relative;width:44px;height:44px;border-radius:12px;border:1px solid var(--uix-border);background:var(--uix-surface);display:flex;align-items:center;justify-content:center;color:var(--uix-text-head);text-decoration:none}
    .lm-count{position:absolute;top:-5px;right:-5px;min-width:20px;height:20px;padding:0 5px;box-sizing:border-box;border-radius:99px;background:var(--uix-danger);color:var(--uix-surface);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;border:2px solid var(--uix-surface)}
    .lm-search{display:flex;align-items:center;gap:8px;height:44px;padding:0 12px;border-radius:12px;background:var(--uix-surface-subtle);color:var(--uix-text-secondary)}
    .lm-search input{border:0;background:transparent;outline:none;font:inherit;font-size:15px;flex:1;color:var(--uix-text-head)}
    .lm-chips{display:flex;gap:8px;overflow-x:auto}
    .lm-pill{flex-shrink:0;height:36px;padding:0 14px;border-radius:999px;font-size:14px;font-weight:500;display:flex;align-items:center;text-decoration:none;background:var(--uix-surface);color:var(--uix-text-head);border:1px solid var(--uix-border-strong)}
    .lm-pill.on{background:var(--uix-info);color:var(--uix-surface);border-color:var(--uix-info);font-weight:600}
    .lm-main{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px}
    .lm-card{background:var(--uix-surface);border:1px solid var(--uix-border);border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:10px;color:var(--uix-text-head);text-decoration:none}
    .lm-card.alert{border-color:var(--uix-danger)}
    .lm-card.warn{border-color:var(--uix-warning-text)}
    .lm-row{display:flex;justify-content:space-between;align-items:center;gap:8px}
    .lm-meta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--uix-text-secondary);flex-wrap:wrap}
    .lm-code{font-size:12px;color:var(--uix-text-secondary);font-weight:600;letter-spacing:.02em}
    .lm-chip{font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap}
    .lm-chip.sm{padding:2px 8px;border-radius:6px;font-weight:700}
    .lm-chip--info{background:var(--uix-info-soft);color:var(--uix-info)}
    .lm-chip--warn{background:var(--uix-warning-soft);color:var(--uix-warning-text)}
    .lm-chip--danger{background:var(--uix-danger-soft);color:var(--uix-danger)}
    .lm-chip--ok{background:var(--uix-success-soft);color:var(--uix-success)}
    .lm-chip--muted{background:var(--uix-surface-subtle);color:var(--uix-text-secondary)}
    .lm-chip--solid-danger{background:var(--uix-danger);color:var(--uix-surface)}
    .lm-bar{flex:1;height:8px;border-radius:99px;background:var(--uix-border);overflow:hidden}
    .lm-bar>div{height:100%;background:var(--uix-info);border-radius:99px}
    .lm-bar.big{height:10px}
    .lm-pct{font-size:13px;font-weight:700;min-width:38px;text-align:right}
    .lm-sect{font-size:13px;color:var(--uix-text-secondary);font-weight:500}
    .lm-kv{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
    .lm-kv div{background:var(--uix-surface-subtle);border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:2px;font-size:13px}
    .lm-kv span:first-child{font-size:12px;color:var(--uix-text-secondary);font-weight:600}
    .lm-note{font-size:13px;line-height:1.4;padding:8px 10px;border-radius:10px;background:var(--uix-warning-soft);color:var(--uix-warning-text)}
    .lm-note.info{background:var(--uix-info-soft);color:var(--uix-info)}
    .lm-note.danger{background:var(--uix-danger-soft);color:var(--uix-danger)}
    .lm-foot{background:var(--uix-surface);border-top:1px solid var(--uix-border);padding:12px 16px 20px;display:flex;gap:8px;flex-direction:column}
    .lm-btn{height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;gap:6px;font-size:15px;font-weight:600;border:0;cursor:pointer;text-decoration:none;box-sizing:border-box;font-family:inherit;width:100%}
    .lm-btn.primary{background:var(--uix-info);color:var(--uix-surface)}
    .lm-btn.ok{background:var(--uix-success);color:var(--uix-surface)}
    .lm-btn.danger{background:var(--uix-danger);color:var(--uix-surface)}
    .lm-btn.outline-danger{background:var(--uix-surface);color:var(--uix-danger);border:1.5px solid var(--uix-danger)}
    .lm-btn.ghost{background:var(--uix-surface);color:var(--uix-text-head);border:1.5px solid var(--uix-border-strong)}
    .lm-btn.soft{background:var(--uix-surface);color:var(--uix-info);border:1px solid var(--uix-border-strong);height:48px;font-size:14px}
    .lm-btn:disabled{opacity:.5;cursor:not-allowed}
    .lm-seg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:4px;border-radius:12px;background:var(--uix-surface-subtle)}
    .lm-seg a,.lm-seg button{height:40px;border-radius:9px;border:0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:500;color:var(--uix-text-secondary);background:transparent;text-decoration:none;cursor:pointer;font-family:inherit}
    .lm-seg a.on,.lm-seg button.on{background:var(--uix-surface);color:var(--uix-text-head);font-weight:600;box-shadow:0 1px 3px rgba(18,24,38,.12)}
    .lm-field{display:flex;flex-direction:column;gap:8px}
    .lm-field label.lbl{font-size:14px;font-weight:600}
    .lm-field textarea,.lm-field input[type=text],.lm-field input[type=number]{border:1px solid var(--uix-border-strong);border-radius:12px;padding:12px;font:inherit;font-size:15px;color:var(--uix-text-head);background:var(--uix-surface);resize:none;box-sizing:border-box;width:100%}
    .lm-opts{display:flex;flex-wrap:wrap;gap:8px}
    .lm-opt{position:relative}
    .lm-opt input{position:absolute;opacity:0;pointer-events:none}
    .lm-opt span{display:inline-flex;align-items:center;height:40px;padding:0 14px;border-radius:999px;border:1px solid var(--uix-border-strong);background:var(--uix-surface);font-size:14px;cursor:pointer}
    .lm-opt input:checked+span{border:1.5px solid var(--uix-info);background:var(--uix-info-soft);color:var(--uix-info);font-weight:600}
    .lm-seg-radio{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:4px;border-radius:12px;background:var(--uix-surface-subtle)}
    .lm-seg-radio label{position:relative}
    .lm-seg-radio input{position:absolute;opacity:0}
    .lm-seg-radio span{display:flex;align-items:center;justify-content:center;height:40px;border-radius:9px;font-size:14px;font-weight:500;color:var(--uix-text-secondary);cursor:pointer}
    .lm-seg-radio input:checked+span{background:var(--uix-surface);color:var(--uix-text-head);font-weight:600;box-shadow:0 1px 3px rgba(18,24,38,.12)}
    .lm-stepper{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;gap:8px;align-items:center}
    .lm-stepper button{height:44px;border-radius:12px;border:1px solid var(--uix-border-strong);background:var(--uix-surface);font-size:20px;cursor:pointer;font-family:inherit}
    .lm-stepper input{text-align:center;font-size:22px;font-weight:700}
    .lm-flash{margin:0 16px;padding:10px 12px;border-radius:12px;font-size:14px;font-weight:500}
    .lm-flash.notice{background:var(--uix-success-soft);color:var(--uix-success)}
    .lm-flash.error{background:var(--uix-danger-soft);color:var(--uix-danger)}
    .lm-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));background:var(--uix-surface);border-top:1px solid var(--uix-border);padding:6px 8px 18px}
    .lm-nav a{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;font-size:12px;color:var(--uix-text-secondary);text-decoration:none;font-weight:500}
    .lm-nav a.on{color:var(--uix-info);font-weight:600}
    .lm-nav svg{width:22px;height:22px}
  </style>
</head>
<body class="lm-body">
  <div class="lm-phone">
    <% if flash[:notice] %><div class="lm-flash notice" role="status"><%= flash[:notice] %></div><% end %>
    <% if flash[:error] %><div class="lm-flash error" role="alert"><%= flash[:error] %></div><% end %>
    <%= yield %>
    <% approver = Lpms3::Leno.approver_any?(User.current) %>
    <nav class="lm-nav" aria-label="Navigasi utama">
      <% if approver %>
        <%= link_to lpms3_m_persetujuan_path, class: (controller_name == "mobile" && %w[persetujuan keputusan tolak].include?(action_name) ? "on" : nil) do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>Persetujuan<% end %>
        <%= link_to projects_path do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>Proyek<% end %>
      <% else %>
        <%= link_to lpms3_m_path, class: (%w[index aktivitas laporan kendala].include?(action_name) ? "on" : nil) do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>Aktivitas<% end %>
        <%= link_to lpms3_m_path(f: "perbaikan") do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></svg>Kendala<% end %>
      <% end %>
      <%= link_to lpms3_m_notifikasi_path, class: (action_name == "notifikasi" ? "on" : nil) do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>Notifikasi<% end %>
      <%= link_to my_account_path do %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>Profil<% end %>
    </nav>
  </div>
</body>
</html>
