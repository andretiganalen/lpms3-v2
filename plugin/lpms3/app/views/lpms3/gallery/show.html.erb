<% content_for :page_title, t("lpms3.gallery.title") %>
<div class="lpms3-page-wide">
  <h1 style="margin:0 0 4px"><%= t("lpms3.gallery.title") %></h1>
  <p style="margin:0 0 16px;color:var(--uix-text-secondary)"><%= @project.name %> · <%= t("lpms3.gallery.hint", days: ::Lpms3::Gallery::WINDOW_DAYS) %></p>
  <% if @photos.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:12px;color:var(--uix-text-secondary)"><%= t("lpms3.gallery.empty") %></div>
  <% else %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px">
      <% @photos.each do |ph| %>
        <figure style="margin:0;border:1px solid var(--uix-border);border-radius:12px;overflow:hidden;background:var(--uix-surface)">
          <img src="<%= api_v3_paths.attachment_content(ph[:id]) %>" alt="<%= ph[:filename] %>" loading="lazy" style="width:100%;height:150px;object-fit:cover;display:block">
          <figcaption style="padding:8px;font-size:12px;color:var(--uix-text-body)">
            <strong><%= I18n.l(ph[:date], format: "%d %b %Y") %></strong> · <%= ph[:progress] %>%<br>
            <span style="color:var(--uix-text-secondary)"><%= ph[:wp_subject] %></span>
          </figcaption>
        </figure>
      <% end %>
    </div>
  <% end %>
</div>
