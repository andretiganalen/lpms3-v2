<% content_for :page_title, "Tugas & Notifikasi" %>
<div class="lpms3-tugas lpms3-page-wide">
  <h1 style="margin:0 0 4px;font-weight:400;font-size:22px;color:var(--leno-title)">Tugas &amp; Notifikasi</h1>
  <p style="margin:0 0 16px;color:var(--uix-text-secondary)">
    Tugas persetujuan yang menunggu tindakan Anda: <strong data-testid="tugas-count"><%= @count %></strong> tugas.
  </p>

  <% if @tasks.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);color:var(--uix-text-secondary)">Tidak ada tugas yang menunggu.</div>
  <% end %>

  <% @tasks.each do |task| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">
        <strong><%= task.work_package.subject %></strong>
        <span style="font-size:12px;padding:3px 8px;border-radius:6px;background:var(--uix-info-soft);color:var(--uix-info)">
          <%= task.stage == "pimpro" ? "Menunggu Pimpro" : "Menunggu Pejabat Eselon 2" %>
        </span>
      </div>
      <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
        <div><span style="color:var(--uix-text-secondary)">Dari:</span> <%= task.requested_by.name %></div>
        <div><span style="color:var(--uix-text-secondary)">Kapan:</span> <%= I18n.l(task.requested_at, format: "%d %b %Y %H:%M") %></div>
        <div><span style="color:var(--uix-text-secondary)">Proyek:</span> <%= task.project.name %></div>
        <% if task.requester_note.present? %>
          <div><span style="color:var(--uix-text-secondary)">Catatan pengaju:</span> <%= task.requester_note %></div>
        <% end %>
        <div><span style="color:var(--uix-text-secondary)">Harus:</span> <strong><%= task.required_action_for(User.current) %></strong></div>
      </div>

      <%= form_with url: lpms3_tugas_langkah_path(task), method: :post, local: true, style: "margin-top:10px" do %>
        <textarea name="catatan" rows="2" placeholder="Catatan (wajib untuk revisi)" style="width:100%;border:1px solid var(--uix-border-strong);border-radius:var(--uix-radius-control);padding:8px"></textarea>
        <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
          <% task.actions_for(User.current).each do |aksi| %>
            <button type="submit" name="tindakan" value="<%= aksi %>"
                    style="height:40px;padding:0 14px;border-radius:var(--uix-radius-control);border:0;font-weight:600;color:var(--uix-surface);background:<%= { "teruskan" => "var(--uix-info)", "setujui" => "var(--uix-success)", "revisi" => "var(--uix-danger)" }[aksi] %>">
              <%= { "teruskan" => "Teruskan ke Pejabat Eselon 2", "setujui" => "Setujui", "revisi" => "Minta revisi" }[aksi] %>
            </button>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @anggota.any? %>
    <h2 style="margin:24px 0 4px">Permintaan anggota proyek <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @anggota.size %> menunggu persetujuan Pimpro)</span></h2>
    <% @anggota.each do |r| %>
      <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
        <strong><%= r.user.name %></strong> → <%= link_to r.project.name, project_path(r.project) %>
        <div style="font-size:13px;margin-top:6px"><span style="color:var(--uix-text-secondary)">Diusulkan:</span> <%= r.requester.name %> · <%= l(r.requested_at, format: :short) %> · Peran: <%= r.roles.map(&:name).join(", ").presence || "Tim Proyek" %></div>
        <%= form_with url: lpms3_tugas_anggota_path(r), method: :post, local: true, style: "margin-top:10px;display:flex;gap:8px;flex-wrap:wrap" do %>
          <input name="catatan" class="lpms3-input" placeholder="Catatan (opsional)" aria-label="Catatan keputusan">
          <button name="keputusan" value="setujui" class="lpms3-btn lpms3-btn--primary">Setujui</button>
          <button name="keputusan" value="tolak" class="lpms3-btn">Tolak</button>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <% if @isian.any? %>
    <h2 style="margin:24px 0 4px">Draft & isian saya <span style="font-size:14px;color:var(--uix-text-secondary)">(draft hanya terlihat oleh Anda sampai diajukan)</span></h2>
    <div class="lpms3-table-wrap"><table class="lpms3-table">
      <thead><tr><th scope="col">Isian</th><th scope="col">Proyek</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Aksi</span></th></tr></thead>
      <tbody>
        <% @isian.each do |wp| %>
          <tr>
            <th scope="row"><%= link_to wp.subject, work_package_path(wp) %><br><small class="lpms3-hint"><%= wp.type.name %></small></th>
            <td><%= wp.project.name %></td>
            <td><span class="lpms3-chip <%= 'lpms3-chip--warn' if ::Lpms3::DraftVisibility.draft?(wp) %>"><%= wp.status.name %></span></td>
            <td>
              <%= form_with url: lpms3_project_ajukan_path(wp.project, wp), method: :post, local: true, class: "lpms3-kontrak__inline" do %>
                <input name="catatan" class="lpms3-input" placeholder="Catatan" aria-label="Catatan pengajuan <%= wp.subject %>">
                <button class="lpms3-btn lpms3-btn--primary">Ajukan</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>

  <% if @kontrak.any? %>
    <h2 style="margin:24px 0 4px">Peringatan Kontrak <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @kontrak.size %>)</span></h2>
    <% @kontrak.each do |k| %>
      <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
        <span class="lpms3-chip <%= k[:finding].severity == :high ? 'lpms3-chip--danger' : 'lpms3-chip--warn' %>"><%= k[:finding].severity == :high ? "Tinggi" : "Sedang" %></span>
        <strong><%= k[:finding].text %></strong>
        <div style="font-size:13px;margin-top:6px"><span style="color:var(--uix-text-secondary)">Proyek:</span> <%= link_to k[:project].name, lpms3_project_kontrak_path(k[:project]) %></div>
      </section>
    <% end %>
  <% end %>

  <% if @baseline_cr.any? %>
    <h2 style="margin:24px 0 4px">Draft Baseline WBS <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @baseline_cr.size %> menunggu pengajuan CR)</span></h2>
    <% @baseline_cr.each do |b| %>
      <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
        <strong><%= b.label %> — <%= b.project.name %></strong>
        <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
          <div><span style="color:var(--uix-text-secondary)">Harus:</span> <strong>Tinjau perubahan lalu ajukan Change Request (Draft → Diajukan)</strong></div>
          <div><%= link_to "Change Request ##{b.change_request_form_id}", work_package_path(b.change_request_form_id) %> · <%= link_to "WBS & Bobot", lpms3_project_wbs_path(b.project) %></div>
        </div>
      </section>
    <% end %>
  <% end %>

  <% if @wbs_pic.any? %>
    <h2 style="margin:24px 0 4px">Penugasan PIC WBS <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @wbs_pic.size %> menunggu)</span></h2>
    <% @wbs_pic.each do |n| %>
      <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
        <strong><%= n.wbs_code %> <%= n.tasks %></strong>
        <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
          <div><span style="color:var(--uix-text-secondary)">Proyek:</span> <%= link_to n.project.name, lpms3_project_wbs_path(n.project) %></div>
          <div><span style="color:var(--uix-text-secondary)">Jadwal:</span> <%= n.date_plan_start ? l(n.date_plan_start) : "—" %> s.d. <%= n.date_plan_finish ? l(n.date_plan_finish) : "—" %></div>
          <div><span style="color:var(--uix-text-secondary)">Harus:</span> <strong>Tugaskan anggota tim <%= n.pic_unit.name %> sebagai PIC</strong></div>
        </div>
        <%= form_with url: lpms3_wbs_tugaskan_path(n), method: :post, local: true, style: "margin-top:10px;display:flex;gap:8px;flex-wrap:wrap" do %>
          <select name="user_id" required class="lpms3-input" aria-label="PIC untuk <%= n.wbs_code %>">
            <% ::Lpms3::Wbs.unit_team(n.pic_unit).each do |u| %><option value="<%= u.id %>"><%= u.name %></option><% end %>
          </select>
          <button type="submit" class="lpms3-btn lpms3-btn--primary">Tugaskan</button>
        <% end %>
      </section>
    <% end %>
  <% end %>

  <h2 style="margin:24px 0 4px">Proyek baru dari LenO <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @pemicu.size %> menunggu)</span></h2>
  <% if @pemicu.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);color:var(--uix-text-secondary)">Tidak ada pemicu LenO yang menunggu tindakan Anda.</div>
  <% end %>
  <% @pemicu.each do |tr| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <div style="display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap">
        <strong><%= tr.nama_proyek.presence || tr.kode_proyek %></strong>
        <span style="font-size:12px;padding:3px 8px;border-radius:6px;background:var(--uix-info-soft);color:var(--uix-info)"><%= t("lpms3.pemicu_leno.status.#{tr.status}") %></span>
      </div>
      <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
        <div><span style="color:var(--uix-text-secondary)">Dari:</span> <%= tr.status == "diusulkan" ? tr.diusulkan_oleh&.name : "LenO" %></div>
        <div><span style="color:var(--uix-text-secondary)">Kapan:</span> <%= I18n.l(tr.status == "diusulkan" ? tr.diusulkan_pada : tr.kiriman_terakhir_pada, format: "%d %b %Y %H:%M") %></div>
        <div><span style="color:var(--uix-text-secondary)">Harus:</span> <strong><%= { "diusulkan" => "Setujui atau kembalikan registrasi", "disetujui" => "Periksa pembuatan proyek" }.fetch(tr.status, "Registrasi proyek (template, Pimpro, VP)") %></strong></div>
      </div>
      <%= link_to "Buka", lpms3_pemicu_path(tr), style: "display:inline-flex;align-items:center;margin-top:10px;height:40px;padding:0 14px;border-radius:var(--uix-radius-control);font-weight:600;color:var(--uix-surface);background:var(--uix-primary);text-decoration:none" %>
    </section>
  <% end %>

  <h2 style="margin:24px 0 4px">Masukan untuk Anda <span style="font-size:14px;color:var(--uix-text-secondary)">(<%= @masukan.size %> terbuka)</span></h2>
  <p style="margin:0 0 12px;color:var(--uix-text-secondary)">Perbaiki sesuai masukan (misalnya typo setelah disetujui), lalu tandai selesai. Tidak perlu reviu ulang.</p>
  <% if @masukan.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);color:var(--uix-text-secondary)">Tidak ada masukan terbuka.</div>
  <% end %>
  <% @masukan.each do |fb| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <strong><%= fb.work_package.subject %></strong>
      <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
        <div><span style="color:var(--uix-text-secondary)">Dari:</span> <%= fb.given_by.name %></div>
        <div><span style="color:var(--uix-text-secondary)">Kapan:</span> <%= I18n.l(fb.given_at, format: "%d %b %Y %H:%M") %></div>
        <div><span style="color:var(--uix-text-secondary)">Masukan:</span> <%= fb.body %></div>
      </div>
      <%= form_with url: lpms3_masukan_selesai_path(fb), method: :post, local: true, style: "margin-top:10px" do %>
        <input name="catatan" placeholder="Catatan perbaikan (opsional)" style="width:100%;border:1px solid var(--uix-border-strong);border-radius:var(--uix-radius-control);padding:8px">
        <button type="submit" style="margin-top:8px;height:40px;padding:0 14px;border-radius:var(--uix-radius-control);border:0;font-weight:600;color:var(--uix-surface);background:var(--uix-success)">Tandai sudah diperbaiki</button>
      <% end %>
    </section>
  <% end %>

  <h2 style="margin:24px 0 4px">Tembusan ke Direksi <span style="font-size:14px;color:var(--uix-text-secondary)">(untuk diketahui)</span></h2>
  <% if @tembusan_candidates.any? %>
    <p style="margin:0 0 12px;color:var(--uix-text-secondary)">Dokumen final (sudah disetujui Eselon 1) yang bisa Anda tembuskan ke Direksi.</p>
    <% @tembusan_candidates.each do |t| %>
      <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
        <strong><%= t.work_package.subject %></strong>
        <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
          <div><span style="color:var(--uix-text-secondary)">Proyek:</span> <%= t.project.name %></div>
          <div><span style="color:var(--uix-text-secondary)">Disetujui:</span> <%= I18n.l(t.decided_at, format: "%d %b %Y %H:%M") %></div>
        </div>
        <%= form_with url: lpms3_tugas_tembusan_path(t), method: :post, local: true, style: "margin-top:10px" do %>
          <button type="submit" style="height:40px;padding:0 14px;border-radius:var(--uix-radius-control);border:0;font-weight:600;color:var(--uix-surface);background:var(--uix-primary)">Laporkan ke Direksi</button>
        <% end %>
      </section>
    <% end %>
  <% end %>
  <% if @tembusan_list.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);color:var(--uix-text-secondary)">Belum ada tembusan yang diterima.</div>
  <% end %>
  <% @tembusan_list.each do |t| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <strong><%= t.work_package.subject %></strong>
      <div style="font-size:13px;color:var(--uix-text-body);margin-top:6px">
        <div><span style="color:var(--uix-text-secondary)">Dari:</span> <%= t.tembusan_by&.name %> (Eselon 1)</div>
        <div><span style="color:var(--uix-text-secondary)">Kapan:</span> <%= I18n.l(t.tembusan_at, format: "%d %b %Y %H:%M") %></div>
        <div><span style="color:var(--uix-text-secondary)">Proyek:</span> <%= t.project.name %> · hanya untuk diketahui</div>
      </div>
    </section>
  <% end %>

  <h2 style="margin:24px 0 4px">Kick-Off Proyek <span style="font-size:14px;color:var(--uix-text-secondary)">(BOP-001 §5.2.2)</span></h2>
  <% if @kickoff_tunjuk.empty? && @kickoff_undang.empty? %>
    <div style="padding:16px;border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);color:var(--uix-text-secondary)">Tidak ada Kick-Off yang menunggu tindakan Anda.</div>
  <% end %>
  <% @kickoff_tunjuk.each do |k| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <strong><%= k.project.name %></strong>
      <p style="font-size:13px;color:var(--uix-text-secondary);margin:6px 0">Dari: Dokumen Inisiasi telah disetujui final. Harus: tunjuk Project Analis (peran "Project Analis" di proyek ini).</p>
      <% if k.analis_candidates.empty? %>
        <div style="font-size:13px;color:var(--uix-danger)">Belum ada anggota proyek dengan peran Project Analis.</div>
      <% else %>
        <%= form_with url: lpms3_kickoff_tunjuk_path(k), method: :post, local: true do %>
          <select name="analis_id" style="border:1px solid var(--uix-border-strong);border-radius:var(--uix-radius-control);padding:8px"><% k.analis_candidates.each do |u| %><option value="<%= u.id %>"><%= u.name %></option><% end %></select>
          <button type="submit" style="height:40px;padding:0 14px;border-radius:var(--uix-radius-control);border:0;font-weight:600;color:var(--uix-surface);background:var(--uix-primary)">Tunjuk Project Analis</button>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <% @kickoff_undang.each do |k| %>
    <section style="border:1px solid var(--uix-border);border-radius:var(--uix-radius-card);padding:14px;margin-bottom:12px;background:var(--uix-surface)">
      <strong><%= k.project.name %></strong>
      <p style="font-size:13px;color:var(--uix-text-secondary);margin:6px 0">Dari: <%= k.assigned_by&.name %> (Fungsi Pengawasan Proyek). Harus: kirim undangan Kick-Off ke seluruh stakeholder.</p>
      <% k.roster.each do |_, r| %>
        <div style="font-size:13px;color:<%= r[:users].any? ? 'var(--uix-success)' : 'var(--uix-danger)' %>"><%= r[:label] %>: <%= r[:users].any? ? r[:users].map(&:name).join(', ') : 'BELUM TERISI (wajib)' %></div>
      <% end %>
      <%= form_with url: lpms3_kickoff_undang_path(k), method: :post, local: true, style: "margin-top:10px" do %>
        <input type="datetime-local" name="waktu" required style="border:1px solid var(--uix-border-strong);border-radius:var(--uix-radius-control);padding:8px">
        <textarea name="agenda" rows="2" placeholder="Agenda rapat" style="width:100%;border:1px solid var(--uix-border-strong);border-radius:var(--uix-radius-control);padding:8px;margin-top:6px"></textarea>
        <button type="submit" style="margin-top:8px;height:40px;padding:0 14px;border-radius:var(--uix-radius-control);border:0;font-weight:600;color:var(--uix-surface);background:var(--uix-success)">Kirim undangan Kick-Off</button>
      <% end %>
    </section>
  <% end %>
</div>
