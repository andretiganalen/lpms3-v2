<% phase_title = t(::OpenProject::Lpms3::Phases.title_key(@phase)) %>
<% html_title phase_title, @project.name %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { phase_title }
    header.with_breadcrumbs([{ href: project_path(@project), text: @project.name }, phase_title])
    header.with_description { t("lpms3.phases.#{@phase.key}.description") }
  end
%>

<div class="lpms3-page">
  <ol class="lpms3-stepper" aria-label="<%= t("lpms3.phases.stepper") %>">
    <% @phases.each_with_index do |ph, i| %>
      <% pr = @progress[ph.key] %>
      <li class="lpms3-stepper__item<%= ' is-current' if ph == @phase %>">
        <%= link_to lpms3_project_phase_path(@project, ph.key), "aria-current": (ph == @phase ? "step" : nil) do %>
          <span class="lpms3-stepper__no"><%= i + 1 %></span>
          <span class="lpms3-stepper__name"><%= t(::OpenProject::Lpms3::Phases.title_key(ph)) %></span>
          <span class="lpms3-stepper__meta"><%= t("lpms3.phases.progress", done: pr[:done], total: pr[:total]) %></span>
        <% end %>
      </li>
    <% end %>
  </ol>

  <% if @all || @section == "gerbang" %>
  <section class="lpms3-card" id="gerbang">
    <h3 class="lpms3-card__title"><%= t("lpms3.phases.gates") %></h3>
    <% if @gates.empty? %>
      <p class="lpms3-hint"><%= t("lpms3.phases.no_gates") %></p>
    <% else %>
      <ul class="lpms3-gates">
        <% @gates.each do |g| %>
          <li>
            <%= link_to g.subject, work_package_path(g) %>
            <span class="lpms3-chip<%= ' lpms3-chip--ok' if g.status.is_closed? %>"><%= g.status.name %></span>
            <% if g.due_date || g.start_date %><span class="lpms3-hint"><%= l(g.due_date || g.start_date) %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <% end %>

  <% if @all || @section == "langkah" %>
  <section class="lpms3-card" id="langkah">
    <h3 class="lpms3-card__title"><%= t("lpms3.phases.steps") %></h3>
    <% if @steps.empty? %>
      <p class="lpms3-hint"><%= t("lpms3.phases.no_steps") %></p>
    <% else %>
      <div class="lpms3-table-wrap">
        <table class="lpms3-table">
          <thead>
            <tr>
              <th scope="col"><%= t("lpms3.phases.col.step") %></th>
              <th scope="col"><%= t("lpms3.phases.col.status") %></th>
              <th scope="col"><%= t("lpms3.phases.col.assignee") %></th>
              <th scope="col"><%= t("lpms3.phases.col.due") %></th>
            </tr>
          </thead>
          <tbody>
            <% @steps.each do |wp| %>
              <tr>
                <th scope="row"><%= link_to wp.subject.sub(/\A\[T\d+-(\d+)\]\s*/, '\1. '), work_package_path(wp) %></th>
                <td><span class="lpms3-chip<%= ' lpms3-chip--ok' if wp.status.is_closed? %>"><%= wp.status.name %></span></td>
                <td><%= wp.assigned_to&.name || t("lpms3.phases.unassigned") %></td>
                <td><%= wp.due_date ? l(wp.due_date) : t("lpms3.phases.no_date") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <% end %>

  <% if (@all || @section == "register") && @type_rows.any? %>
    <section class="lpms3-card" id="register">
      <h3 class="lpms3-card__title"><%= t("lpms3.phases.registers") %></h3>
      <ul class="lpms3-registers">
        <% @type_rows.each do |type, total, done| %>
          <% props = { f: [{ n: "type", o: "=", v: [type.id.to_s] }, { n: "status", o: "*", v: [] }], t: "id:desc" }.to_json %>
          <li>
            <%= link_to type.name, project_work_packages_path(@project, query_props: props) %>
            <span class="lpms3-hint"><%= t("lpms3.phases.progress", done:, total:) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @section == "aspek" %>
  <section class="lpms3-card" id="aspek">
    <h3 class="lpms3-card__title"><%= t("lpms3.pmp9.title") %></h3>
    <p class="lpms3-hint"><%= t("lpms3.pmp9.hint") %></p>
    <div class="lpms3-sticky-bar" role="region" aria-label="Pengajuan aspek">
      <span class="lpms3-sticky-bar__info">
        <% if @can_edit %>
          <strong><%= @aspek_ready_ids.size %></strong> aspek siap diajukan
        <% else %>
          Mode lihat saja
        <% end %>
      </span>
      <span class="lpms3-sticky-bar__actions">
        <% if @can_edit && @aspek_ready_ids.any? %>
          <%= form_with url: lpms3_project_ajukan_semua_path(@project), method: :post, local: true, data: { turbo: false } do %>
            <%= submit_tag "Ajukan semua aspek", class: "lpms3-btn -primary lpms3-btn--lg" %>
          <% end %>
        <% end %>
        <%= link_to "Unduh PDF", lpms3_project_pdf_aspek_path(@project), class: "lpms3-btn" %>
      </span>
    </div>
    <% if @aspects.empty? %>
      <p class="lpms3-hint"><%= t("lpms3.pmp9.empty") %></p>
    <% else %>
      <div class="lpms3-table-wrap">
        <table class="lpms3-table">
          <thead>
            <tr>
              <th scope="col"><%= t("lpms3.pmp9.col.aspect") %></th>
              <th scope="col"><%= t("lpms3.pmp9.col.status") %></th>
              <th scope="col"><%= t("lpms3.pmp9.col.content") %></th>
              <th scope="col"><%= t("lpms3.pmp9.col.attachments") %></th>
              <th scope="col"><%= t("lpms3.pmp9.col.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @aspects.each do |wp| %>
              <% aspect_name = ::OpenProject::Lpms3::Aspects.name(wp) %>
              <% locked = !::OpenProject::Lpms3::Aspects.content_editable?(wp, User.current, @project) %>
              <tr>
                <th scope="row"><%= link_to aspect_name, work_package_path(wp) %></th>
                <td><span class="lpms3-chip<%= ' lpms3-chip--ok' if wp.status.name == "Disahkan" %>"><%= wp.status.name %></span></td>
                <td>
                  <% if @can_edit && !locked %>
                    <%= form_with url: lpms3_project_aspect_update_path(@project, wp), method: :patch, local: true, data: { turbo: false } do %>
                      <%= text_area_tag :description, wp.description, rows: 5, "aria-label": aspect_name, class: "lpms3-input" %>
                      <p><%= submit_tag t("lpms3.pmp9.save"), class: "lpms3-btn" %></p>
                    <% end %>
                  <% else %>
                    <div><%= simple_format(wp.description.to_s) %></div>
                  <% end %>
                </td>
                <td>
                  <% if wp.attachments.any? %>
                    <ul class="lpms3-registers">
                      <% wp.attachments.each do |a| %>
                        <li><%= link_to a.filename, api_v3_paths.attachment_content(a.id) %></li>
                      <% end %>
                    </ul>
                  <% else %>
                    <p class="lpms3-hint"><%= t("lpms3.pmp9.no_attachments") %></p>
                  <% end %>
                  <% if @can_attach && @can_edit && !locked %>
                    <%= form_with url: lpms3_project_aspect_attach_path(@project, wp), method: :post, multipart: true, local: true, data: { turbo: false } do %>
                      <%= file_field_tag :file, required: true %>
                      <%= submit_tag t("lpms3.pmp9.upload"), class: "lpms3-btn" %>
                    <% end %>
                  <% end %>
                </td>
                <td>
                  <% if @can_edit && %w[Draft Revisi].include?(wp.status.name) %>
                    <%= form_with url: lpms3_project_aspect_step_path(@project, wp), method: :post, local: true, data: { turbo: false } do %>
                      <%= hidden_field_tag :step, "submit" %>
                      <%= submit_tag t("lpms3.pmp9.submit"), class: "lpms3-btn -primary" %>
                    <% end %>
                  <% end %>
                  <% if @aspek_pending.include?(wp.id) %>
                    <p class="lpms3-hint">Menunggu persetujuan berjenjang.</p>
                  <% end %>
                  <% unless @can_edit %>
                    <%= form_with url: lpms3_masukan_path(wp), method: :post, local: true, data: { turbo: false } do %>
                      <%= text_area_tag :masukan, nil, rows: 2, required: true, "aria-label": "Masukan untuk pembuat", placeholder: "Beri masukan (mis. typo)", class: "lpms3-input" %>
                      <%= submit_tag "Kirim masukan", class: "lpms3-btn" %>
                    <% end %>
                  <% end %>
                  <% if @is_approver && wp.status.name == "Reviu" %>
                    <%= form_with url: lpms3_project_aspect_step_path(@project, wp), method: :post, local: true, data: { turbo: false } do %>
                      <%= hidden_field_tag :step, "revision" %>
                      <%= text_area_tag :note, nil, rows: 2, required: true, "aria-label": t("lpms3.pmp9.note"), placeholder: t("lpms3.pmp9.note") %>
                      <%= submit_tag t("lpms3.pmp9.revision"), class: "lpms3-btn" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
  <% end %>

  <p>
    <% props = { f: [{ n: "subject", o: "~", v: ["[#{@phase.prefix}-"] }, { n: "status", o: "*", v: [] }], t: "id:asc" }.to_json %>
    <%= link_to t("lpms3.phases.open_table"), project_work_packages_path(@project, query_props: props), class: "button" %>
  </p>
</div>
