<% digest = OpenProject::Lpms3::Assets.digest %>
<link rel="preload" as="font" type="font/woff2" crossorigin href="<%= lpms3_asset_path(digest:, asset: "fonts/poppins-latin-400.woff2") %>">
<link rel="preload" as="font" type="font/woff2" crossorigin href="<%= lpms3_asset_path(digest:, asset: "fonts/poppins-latin-500.woff2") %>">
<link rel="stylesheet" href="<%= lpms3_asset_path(digest:, asset: "uix/uix.css") %>">
<% branding_css = OpenProject::Lpms3::Branding.css %>
<%= content_tag(:style, branding_css.html_safe) if branding_css.present? %>
<% if (fav = OpenProject::Lpms3::Branding.favicon) %>
  <%= javascript_tag(nonce: true) do %>
    (function () {
      var uri = <%= raw fav.to_json %>;
      document.querySelectorAll('link[rel~="icon"], link[rel="apple-touch-icon"]').forEach(function (l) { l.remove(); });
      ['icon', 'apple-touch-icon'].forEach(function (rel) {
        var l = document.createElement('link'); l.rel = rel; l.href = uri; document.head.appendChild(l);
      });
    })();
  <% end %>
<% end %>
<% if User.current.logged? %>
  <% langs = Setting.available_languages.map(&:to_s) %>
  <% if langs.size > 1 %>
    <%= javascript_tag(nonce: true) do %>
      (function () {
        var langs = <%= raw langs.to_json %>, current = <%= raw((User.current.language.presence || Setting.default_language).to_s.to_json) %>;
        function init() {
          var end = document.querySelector('.op-app-header--end');
          if (!end || document.getElementById('lpms3-lang')) { return; }
          var meta = document.querySelector('meta[name="csrf-token"]');
          var f = document.createElement('form');
          f.id = 'lpms3-lang'; f.method = 'post'; f.action = <%= raw lpms3_language_path.to_json %>;
          f.setAttribute('aria-label', 'Bahasa / Language');
          var t = document.createElement('input'); t.type = 'hidden'; t.name = 'authenticity_token'; t.value = meta ? meta.content : ''; f.appendChild(t);
          var b = document.createElement('input'); b.type = 'hidden'; b.name = 'back'; b.value = location.pathname + location.search; f.appendChild(b);
          langs.forEach(function (code) {
            var btn = document.createElement('button');
            btn.type = 'submit'; btn.name = 'lang'; btn.value = code; btn.textContent = code.toUpperCase();
            btn.className = 'lpms3-lang__btn' + (code === current ? ' is-active' : '');
            if (code === current) { btn.setAttribute('aria-current', 'true'); }
            f.appendChild(btn);
          });
          end.insertBefore(f, end.firstChild);
        }
        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('turbo:load', init);
        document.addEventListener('turbo:render', init);
      })();
    <% end %>
  <% end %>
<% end %>
<% if User.current.logged? %>
  <% settings_href = User.current.admin? ? admin_index_path : my_account_path %>
  <% settings_label = User.current.admin? ? t("lpms3.sidebar.settings") : t("lpms3.sidebar.my_settings") %>
