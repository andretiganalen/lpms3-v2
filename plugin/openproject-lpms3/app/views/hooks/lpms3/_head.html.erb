      var ICON = {
        reminder: '<svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3.5a5 5 0 1 0 0 10 5 5 0 0 0 0-10ZM1.5 8.5a6.5 6.5 0 1 1 13 0 6.5 6.5 0 0 1-13 0ZM8 5a.75.75 0 0 1 .75.75v2.44l1.53 1.53a.75.75 0 1 1-1.06 1.06l-1.75-1.75A.75.75 0 0 1 7.25 8.5V5.75A.75.75 0 0 1 8 5ZM3.28.97a.75.75 0 0 1 0 1.06l-1.5 1.5A.75.75 0 0 1 .72 2.47l1.5-1.5a.75.75 0 0 1 1.06 0Zm9.44 0a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 1 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06Z"/></svg>',
        tasklist: '<svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 1.75v11.5c0 .14.11.25.25.25h3.17a.75.75 0 0 1 0 1.5H2.75A1.75 1.75 0 0 1 1 13.25V1.75C1 .78 1.78 0 2.75 0h8.5C12.22 0 13 .78 13 1.75v7.74a.75.75 0 0 1-1.5 0V1.75a.25.25 0 0 0-.25-.25h-8.5a.25.25 0 0 0-.25.25Zm13.27 9.47a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06l1.47 1.47 3.97-3.97a.75.75 0 0 1 1.06 0ZM4.75 4h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Zm0 3h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5Z"/></svg>',
        notifikasi: '<svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M8 16a2 2 0 0 0 1.985-1.75c.017-.137-.097-.25-.235-.25h-3.5c-.138 0-.252.113-.235.25A2 2 0 0 0 8 16ZM3 5a5 5 0 0 1 10 0v2.947c0 .05.015.098.042.139l1.703 2.555A1.519 1.519 0 0 1 13.482 13H2.518a1.516 1.516 0 0 1-1.263-2.36l1.703-2.554A.255.255 0 0 0 3 7.947Zm5-3.5A3.5 3.5 0 0 0 4.5 5v2.947c0 .346-.102.683-.294.97l-1.703 2.556a.017.017 0 0 0-.003.01l.001.006c0 .002.002.004.004.006l.006.004.007.001h10.964l.007-.001.006-.004.004-.006.001-.007a.017.017 0 0 0-.003-.01l-1.703-2.554a1.745 1.745 0 0 1-.294-.97V5A3.5 3.5 0 0 0 8 1.5Z"/></svg>',
        refresh: '<svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7.002 7.002 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A.25.25 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7.002 7.002 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/></svg>'
      };
      var PANELS = [
        { key: 'reminder', label: 'Reminder', empty: 'Tidak ada reminder untuk Anda' },
        { key: 'tasklist', label: 'Tasklist', empty: 'Tidak ada tugas yang menunggu', link: { text: 'Lihat dalam grid', href: cfg.grid } },
        { key: 'notifikasi', label: 'Notifikasi', empty: 'Tidak ada notifikasi baru', link: { text: 'Lihat semua', href: cfg.semua }, baca: true }
      ];
      var data = cfg.data || {};

      function el(tag, cls, text) { var e = document.createElement(tag); if (cls) { e.className = cls; } if (text != null) { e.textContent = text; } return e; }

      function renderList(p, box) {
        var d = data[p.key] || { count: 0, items: [] };
        var list = box.querySelector('.lpms3-hdr__list');
        list.innerHTML = '';
        if (!d.items || !d.items.length) {
          var e = el('li', 'lpms3-hdr__empty');
          e.appendChild(el('strong', null, 'Kosong!'));
          e.appendChild(el('span', null, p.empty));
          list.appendChild(e);
        } else {
          d.items.forEach(function (it) {
            var li = el('li', 'lpms3-hdr__entry' + (it.tone ? ' is-' + it.tone : ''));
            var a = el('a'); a.href = it.href || '#';
            var top = el('span', 'lpms3-hdr__top');
            top.appendChild(el('span', 'lpms3-hdr__who', it.from || it.title));
            if (it.waktu) { top.appendChild(el('span', 'lpms3-hdr__time', it.waktu)); }
            a.appendChild(top);
            if (it.from) { a.appendChild(el('span', 'lpms3-hdr__title', it.title)); }
            if (it.text) { a.appendChild(el('span', 'lpms3-hdr__text', it.text)); }
            li.appendChild(a); list.appendChild(li);
          });
        }
        var badge = box.querySelector('.lpms3-hdr__badge');
        badge.textContent = d.count > 99 ? '99+' : String(d.count || 0);
        badge.hidden = !d.count;
        box.querySelector('.lpms3-hdr__btn').setAttribute('aria-label', p.label + (d.count ? ' (' + d.count + ')' : ''));
      }

      function renderAll() {
        PANELS.forEach(function (p) { var box = document.getElementById('lpms3-hdr-' + p.key); if (box) { renderList(p, box); } });
      }

      function refresh() {
        return fetch(cfg.refresh, { headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (j) { if (j) { data = j; renderAll(); } })
          .catch(function () {});
      }

      function closeAll(except) {
        document.querySelectorAll('.lpms3-hdr__item.is-open').forEach(function (b) {
          if (b === except) { return; }
          b.classList.remove('is-open');
          b.querySelector('.lpms3-hdr__panel').hidden = true;
          b.querySelector('.lpms3-hdr__btn').setAttribute('aria-expanded', 'false');
        });
      }

      function build(p) {
        var box = el('div', 'lpms3-hdr__item'); box.id = 'lpms3-hdr-' + p.key;
        var btn = el('button', 'lpms3-hdr__btn'); btn.type = 'button';
        btn.setAttribute('aria-haspopup', 'dialog'); btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-controls', 'lpms3-hdr-panel-' + p.key); btn.title = p.label;
        btn.innerHTML = ICON[p.key];
        var badge = el('span', 'lpms3-hdr__badge'); badge.hidden = true; btn.appendChild(badge);
        var panel = el('div', 'lpms3-hdr__panel'); panel.id = 'lpms3-hdr-panel-' + p.key; panel.hidden = true;
        panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-label', p.label);
        var head = el('div', 'lpms3-hdr__head');
        var title = el('span', 'lpms3-hdr__label', p.label);
        var re = el('button', 'lpms3-hdr__refresh'); re.type = 'button'; re.title = 'Muat ulang'; re.setAttribute('aria-label', 'Muat ulang ' + p.label);
        re.innerHTML = ICON.refresh;
        re.addEventListener('click', function () { re.classList.add('is-busy'); refresh().then(function () { re.classList.remove('is-busy'); }); });
        title.appendChild(re); head.appendChild(title);
        var links = el('span', 'lpms3-hdr__links');
        if (p.baca) {
          var baca = el('button', 'lpms3-hdr__link', 'Tandai sudah dibaca'); baca.type = 'button';
          baca.addEventListener('click', function () {
            var meta = document.querySelector('meta[name="csrf-token"]');
            fetch(cfg.baca, { method: 'POST', credentials: 'same-origin',
                              headers: { Accept: 'application/json', 'X-CSRF-Token': meta ? meta.content : '', 'X-Requested-With': 'XMLHttpRequest' } })
              .then(refresh);
          });
          links.appendChild(baca);
        }
        if (p.link) { var a = el('a', 'lpms3-hdr__link', p.link.text); a.href = p.link.href; links.appendChild(a); }
        head.appendChild(links);
        panel.appendChild(head);
        panel.appendChild(el('ul', 'lpms3-hdr__list'));
        btn.addEventListener('click', function (ev) {
          ev.stopPropagation();
          var open = !box.classList.contains('is-open');
          closeAll(box);
          box.classList.toggle('is-open', open); panel.hidden = !open; btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (open) { refresh(); }
        });
        panel.addEventListener('click', function (ev) { ev.stopPropagation(); });
        box.appendChild(btn); box.appendChild(panel);
        return box;
      }

      function init() {
        var end = document.querySelector('.op-app-header--end');
        if (!end || document.getElementById('lpms3-hdr')) { return; }
        var wrap = el('div', 'lpms3-hdr'); wrap.id = 'lpms3-hdr';
        PANELS.forEach(function (p) { wrap.appendChild(build(p)); });
        var bell = end.querySelector('.op-ian-bell');
        var anchor = bell ? bell.closest('.op-app-menu--item') : end.firstChild;
        end.insertBefore(wrap, anchor);
        // Blok profil: nama tebal + jabatan kecil, di kiri avatar (seperti LenO).
        var avatar = end.querySelector('.op-top-menu-user-avatar');
        var avatarBtn = avatar && avatar.closest('button');
        if (avatarBtn && !document.getElementById('lpms3-hdr-user')) {
          var who = el('span', 'lpms3-hdr__user'); who.id = 'lpms3-hdr-user';
          who.appendChild(el('strong', null, cfg.nama));
          if (cfg.jabatan) { who.appendChild(el('small', null, cfg.jabatan)); }
          avatarBtn.classList.add('lpms3-hdr__userbtn');
          avatarBtn.querySelector('.Button-label').insertBefore(who, avatar);
        }
        renderAll();
      }

      if (!window.__lpms3HeaderGlobal) {
        window.__lpms3HeaderGlobal = true;
        document.addEventListener('click', function () { closeAll(null); });
        document.addEventListener('keydown', function (ev) {
          if (ev.key !== 'Escape') { return; }
          var open = document.querySelector('.lpms3-hdr__item.is-open');
          if (open) { closeAll(null); open.querySelector('.lpms3-hdr__btn').focus(); }
        });
        setInterval(function () { if (document.visibilityState === 'visible') { refresh(); } }, 60000);
      }
      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('turbo:load', init);
      document.addEventListener('turbo:render', init);
      if (document.readyState !== 'loading') { init(); }
    })();
  <% end %>
<% end %>
<%# Sidebar akordeon gaya LenO: submenu terbuka di bawah induknya (chevron), menu utama tetap terlihat.
    Menggantikan perilaku "turun ke submenu" bawaan OpenProject (menus--main#descend). %>
<%= javascript_tag(nonce: true) do %>
  (function () {
    function sync(li) {
      var t = li.querySelector(':scope > .main-item-wrapper > .main-menu-toggler');
      if (t) { t.setAttribute('aria-expanded', li.classList.contains('lpms3-acc') ? 'true' : 'false'); }
    }
    function flatten(root) {
      if (!root.classList.contains('closed')) { return; }
      root.querySelectorAll(':scope > li.open').forEach(function (li) { li.classList.remove('open'); li.classList.add('lpms3-acc'); sync(li); });
      root.classList.remove('closed'); root.classList.add('open');
    }
    function setup() {
      var root = document.querySelector('#main-menu ul.menu_root');
      if (!root || root.dataset.lpms3Acc) { return; }
      root.dataset.lpms3Acc = '1';
      flatten(root);
      // OpenProject menandai anak submenu "terpilih" walau halamannya lain (mis. Wiki di My Page): rapikan.
      root.querySelectorAll('ul.main-menu--children a.selected').forEach(function (a) {
        var here = location.pathname, p = a.pathname;
        if (p && p !== here && here.indexOf(p + '/') !== 0) { a.classList.remove('selected'); }
      });
      root.querySelectorAll(':scope > li').forEach(function (li) {
        if (li.querySelector(':scope > ul.main-menu--children a.selected')) { li.classList.add('lpms3-acc'); }
        sync(li);
      });
      new MutationObserver(function () { flatten(root); }).observe(root, { attributes: true, attributeFilter: ['class'] });
    }
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('#main-menu .main-menu-toggler');
      if (!t) { return; }
      var li = t.closest('li');
      if (!li) { return; }
      e.preventDefault(); e.stopImmediatePropagation();
      li.classList.toggle('lpms3-acc');
      sync(li);
    }, true);
    // Pola LenO: klik JUDUL menu (bukan hanya panah) membuka/menutup submenunya; halaman tidak dibuka.
    // Berlaku untuk menu utama yang punya anak (termasuk Inisiasi s.d. Penutupan) dan sub-kelompok "Ringkasan Fase".
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) { return; }
      var a = e.target.closest && e.target.closest('#main-menu a.op-menu--item-action');
      if (!a) { return; }
      var btn = null;
      var wrap = a.parentElement;
      if (wrap && wrap.classList.contains('main-item-wrapper')) { btn = wrap.querySelector(':scope > .main-menu-toggler'); }
      var li = a.parentElement && a.parentElement.closest('li');
      if (!btn && li && li.classList.contains('lpms3-grp') && a.parentElement === li) { btn = li.querySelector(':scope > .lpms3-grp-toggle'); }
      if (!btn) { return; }
      e.preventDefault(); e.stopImmediatePropagation();
      btn.click();
    }, true);
    document.addEventListener('DOMContentLoaded', setup);
    document.addEventListener('turbo:load', setup);
    if (document.readyState !== 'loading') { setup(); }
  })();
<% end %>
