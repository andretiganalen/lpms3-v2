        if (onSettings) { a.setAttribute('aria-current', 'page'); }
        a.innerHTML = '<svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.038.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 1.26a8.006 8.006 0 0 1-1.402 0c-.743-.064-1.289-.614-1.458-1.26l-.289-1.106c-.018-.066-.079-.158-.212-.224a5.738 5.738 0 0 1-.668-.386c-.123-.082-.233-.09-.299-.071l-1.103.303c-.644.176-1.392-.021-1.82-.63a8.12 8.12 0 0 1-.704-1.218c-.315-.675-.111-1.422.363-1.891l.815-.806c.05-.048.098-.147.088-.294a6.214 6.214 0 0 1 0-.772c.01-.147-.038-.246-.088-.294l-.815-.806C.635 6.045.431 5.298.746 4.623a7.92 7.92 0 0 1 .704-1.217c.428-.61 1.176-.807 1.82-.63l1.102.302c.067.019.177.011.3-.071.214-.143.437-.272.668-.386.133-.066.194-.158.211-.224l.29-1.106C6.009.645 6.556.095 7.299.03 7.53.01 7.764 0 8 0Zm-.571 1.525c-.036.003-.108.036-.123.098l-.289 1.106c-.17.649-.665 1.07-1.18 1.27-.147.057-.29.123-.427.198-.5.272-1.12.272-1.653-.073l-1.103-.303c-.066-.019-.176-.011-.299.071a6.5 6.5 0 0 0-.58.998c-.067.143-.011.256.059.325l.815.806c.405.401.614.969.6 1.534a4.8 4.8 0 0 0 0 .62c.014.565-.195 1.133-.6 1.534l-.815.806c-.07.069-.126.182-.059.325.164.351.358.686.58.998.123.082.233.09.299.071l1.102-.302c.534-.146 1.154-.146 1.653.073.137.075.28.141.427.198.515.2 1.01.62 1.18 1.27l.29 1.106c.014.062.086.095.122.098a6.53 6.53 0 0 0 1.142 0c.036-.003.108-.036.123-.098l.289-1.106c.17-.649.665-1.07 1.18-1.27.147-.057.29-.123.427-.198.5-.272 1.12-.272 1.653.073l1.103.303c.066.019.176.011.299-.071.222-.312.416-.647.58-.998.067-.143.011-.256-.059-.325l-.815-.806c-.405-.401-.614-.969-.6-1.534a4.8 4.8 0 0 0 0-.62c-.014-.565.195-1.133.6-1.534l.815-.806c.07-.069.126-.182.059-.325a6.5 6.5 0 0 0-.58-.998c-.123-.082-.233-.09-.299-.071l-1.102.302c-.534.146-1.154.146-1.653-.073a4.9 4.9 0 0 0-.427-.198c-.515-.2-1.01-.62-1.18-1.27l-.29-1.106c-.014-.062-.086-.095-.122-.098a6.53 6.53 0 0 0-1.142 0ZM8 5.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM6.5 8a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0Z"/></svg><span></span>';
        a.querySelector('span').textContent = label;
        box.appendChild(a); side.appendChild(box);
      }
      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('turbo:load', init);
      document.addEventListener('turbo:render', init);
    })();
  <% end %>
