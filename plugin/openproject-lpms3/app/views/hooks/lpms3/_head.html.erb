806c-.405-.401-.614-.969-.6-1.534a4.8 4.8 0 0 0 0-.62c-.014-.565.195-1.133.6-1.534l.815-.806c.07-.069.126-.182.059-.325a6.5 6.5 0 0 0-.58-.998c-.123-.082-.233-.09-.299-.071l-1.102.302c-.534.146-1.154.146-1.653-.073a4.9 4.9 0 0 0-.427-.198c-.515-.2-1.01-.62-1.18-1.27l-.29-1.106c-.014-.062-.086-.095-.122-.098a6.53 6.53 0 0 0-1.142 0ZM8 5.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM6.5 8a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0Z"/></svg><span></span>';
        a.querySelector('span').textContent = label;
        box.appendChild(a); side.appendChild(box);
      }
      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('turbo:load', init);
      document.addEventListener('turbo:render', init);
    })();
  <% end %>
<% end %>
<%= javascript_tag(nonce: true) do %>
  // Menu fase BOP-001: panah membuka/menutup anak fase di tempat (submenu inline seperti Explore di :8585), tanpa drilldown OpenProject.
  (function () {
    if (window.__lpms3PhaseToggle) { return; }
    window.__lpms3PhaseToggle = true;
    document.addEventListener('click', function (ev) {
      var t = ev.target && ev.target.closest && ev.target.closest('#main-menu li[data-name^="lpms3_fase_"] > .main-item-wrapper > button.main-menu-toggler');
      if (!t) { return; }
      ev.preventDefault();
      ev.stopImmediatePropagation();
      var li = t.closest('li');
      var open = !li.classList.contains('open');
      li.classList.toggle('open', open);
      t.setAttribute('aria-expanded', open ? 'true' : 'false');
    }, true);
  })();
  // Sidebar tetap (tidak dimuat ulang) saat berpindah halaman lewat Turbo Drive, seperti sidebar :8585.
  // Elemen #main-menu ditandai data-turbo-permanent selama konteksnya sama (project atau area yang sama);
  // bila konteks berganti (mis. pindah project atau ke Administrasi), sidebar baru dipakai.
  (function () {
    if (window.__lpms3SidebarPersist) { return; }
    window.__lpms3SidebarPersist = true;

    function context(root) {
      var a = root && root.querySelector('#menu-sidebar a.op-menu--item-action[href]');
      if (!a) { return null; }
      try { return new URL(a.href, location.href).pathname.split('/').slice(0, 3).join('/'); } catch (e) { return null; }
    }

    function syncSelected() {
      var nav = document.getElementById('main-menu');
      if (!nav) { return; }
      var path = location.pathname, best = null, len = -1;
      nav.querySelectorAll('a.op-menu--item-action[href]').forEach(function (a) {
        var p;
        try { p = new URL(a.href, location.href).pathname; } catch (e) { return; }
        if ((path === p || path.indexOf(p + '/') === 0) && p.length > len) { best = a; len = p.length; }
      });
      nav.querySelectorAll('a.op-menu--item-action.selected').forEach(function (a) { a.classList.remove('selected'); });
      if (best) { best.classList.add('selected'); }
      // Induk-anak: bila item terpilih adalah anak (Ringkasan/Gerbang/Langkah/Register), induk fasenya dibuka dan ikut tersorot.
      var root = nav.querySelector('ul.menu_root');
      nav.querySelectorAll('ul.menu_root > li.open').forEach(function (li) { li.classList.remove('open'); });
      var li = best && best.closest('ul.main-menu--children') ? best.closest('ul.menu_root > li') : null;
      if (root) { root.classList.remove('closed'); }
      if (li) {
        li.classList.add('open');
        var head = li.querySelector('.main-item-wrapper a.op-menu--item-action');
        if (head) { head.classList.add('selected'); }
      }
    }

    document.addEventListener('turbo:before-render', function (event) {
      var current = document.getElementById('main-menu');
      var incoming = event.detail && event.detail.newBody && event.detail.newBody.querySelector('#main-menu');
      if (!current || !incoming) { return; }
      if (context(current) === context(incoming)) {
        current.setAttribute('data-turbo-permanent', '');
        incoming.setAttribute('data-turbo-permanent', '');
      } else {
        current.removeAttribute('data-turbo-permanent');
      }
    });
    document.addEventListener('turbo:render', syncSelected);
    document.addEventListener('turbo:load', syncSelected);
  })();
<% end %>
